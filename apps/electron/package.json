{
  "name": "@yave/electron",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main/main.js",
  "scripts": {
    "build:renderer": "pnpm --filter @yave/web exec vite build --base=./ --outDir ../electron/dist/renderer --emptyOutDir",
    "build": "pnpm build:renderer && tsc",
    "dev": "pnpm build && electron .",
    "start": "tsc && electron ."
  },
  "dependencies": {
    "@yave/core": "workspace:*",
    "@yave/platform": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "electron": "^31.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
